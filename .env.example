# ==========================================
# EduAI Suite v2 Environment Configuration
# ==========================================

# Django Settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=eduai-insecure-dev-secret-key-change-in-production-2026!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://eduai:eduai_dev_password@localhost:5432/eduai_suite
USE_SQLITE_FALLBACK=True

# Redis Configuration (Channels / Cache / Celery)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=eduai-jwt-secret-key-for-dual-auth-token-signing-2026!
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/auth/google-calendar/callback
FRONTEND_URL=http://localhost:5173

# Groq LLM API
GROQ_API_KEY=your-groq-api-key

# Supabase Storage (Presentation Uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=edui-presentations

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
