# Django backend environment. Copy to backend/.env for local Docker use.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Docker Compose overrides DATABASE_URL and REDIS_URL for the containers.
DATABASE_URL=postgres://eduai:eduai_dev_password@localhost:5432/eduai_suite
USE_SQLITE_FALLBACK=True
REDIS_URL=redis://localhost:6379/0

# Django-issued JWTs
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google Identity Services / Calendar
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/auth/google-calendar/callback
FRONTEND_URL=http://localhost:5173

# Optional AI integration
GROQ_API_KEY=your-groq-api-key

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
