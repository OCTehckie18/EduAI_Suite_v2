# EduAI Suite company backend. Copy to .env and fill in. Nothing here belongs to a university.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Postgres. Leave unset to use a local SQLite file (fine for tests and quick local runs).
DATABASE_URL=postgres://business:business@localhost:5432/business

# The product website(s) allowed to post the demo form.
CORS_ALLOWED_ORIGINS=http://localhost:5180,https://www.example.com

# How many demo requests one address may send.
DEMO_REQUEST_RATE=5/hour

# Where new demo requests are emailed, sent over the company's own SMTP account.
SALES_EMAIL=sales@example.com
SALES_FROM_EMAIL=EduAI Suite <no-reply@example.com>
SALES_SMTP_HOST=smtp.example.com
SALES_SMTP_PORT=587
SALES_SMTP_USER=
SALES_SMTP_PASSWORD=
SALES_SMTP_USE_TLS=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
