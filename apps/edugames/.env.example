# Leave VITE_API_URL empty to use same-origin /api (vite dev proxy / vercel rewrite).
# Set it to an absolute backend URL to bypass the proxy.
VITE_API_URL=
# Dev proxy target for /api (used by vite.config.ts)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
