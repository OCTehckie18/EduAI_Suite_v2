# Leave VITE_API_URL empty to use the same-origin /api/v1 proxy.
VITE_API_URL=
# Used by the Vite development server and Docker Compose.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Where each portal lives. In development they default to ports 5174, 5173 and 5175 of this host.
VITE_EDUGAMES_URL=
VITE_TEACHERBUDDY_URL=
VITE_ADMIN_URL=
