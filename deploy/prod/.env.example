# Copy to .env and fill in every value. Never commit the real file.

# ---- Where the four websites live (DNS must point all four names at this server) ----
LANDING_HOST=campus.example.edu
ADMIN_HOST=admin.example.edu
TEACHER_HOST=teach.example.edu
STUDENT_HOST=play.example.edu
# https when TLS is in front of the edge (Caddy or a load balancer); http only for a trial on a private network
PUBLIC_SCHEME=https
# Host port of the edge. Leave 80 unless another web server uses it.
EDGE_PORT=80

# ---- Secrets: generate each with: python -c "import secrets; print(secrets.token_urlsafe(50))" ----
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
# Encrypts stored Google Calendar permissions: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_KEY=

# ---- Django ----
DJANGO_ALLOWED_HOSTS=campus.example.edu,admin.example.edu,teach.example.edu,play.example.edu
CSRF_TRUSTED_ORIGINS=https://campus.example.edu,https://admin.example.edu,https://teach.example.edu,https://play.example.edu
# Set to False only for a trial over plain http
SECURE_SSL_REDIRECT=True
FRONTEND_URL=https://campus.example.edu

# ---- Google sign-in (the same client id is built into TeacherBuddy and EduGames) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://admin.example.edu/api/v1/calendar/google/callback

# ---- Optional ----
GROQ_API_KEY=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Sizing (the defaults suit one 4-core server for a few thousand students) ----
# WEB_CONCURRENCY=9      gunicorn processes (default: 2 x CPU cores + 1)
# WEB_THREADS=4          threads per process
# DB_POOL_MAX=10         database connections per process; processes x this must stay under POSTGRES_MAX_CONNECTIONS
# POSTGRES_MAX_CONNECTIONS=200
# REDIS_MAXMEMORY=256mb
# CHANNEL_CAPACITY=1500  messages one live-game connection may queue
